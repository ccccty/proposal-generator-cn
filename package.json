{
  "name": "proposal-generator-cn",
  "version": "1.3.0",
  "description": "项目书生成：军工/国家级科研项目申报书撰写技能 bundle（DSH profile bundle）。内含文体铁律（正文零元信息、指标五拍论证、公式规范）、10 份参考材料、6 份可复制模板、2 份文体样板，以及自检/转换/复查三件套工具（Markdown→Word 原生公式、正文合规自检、成品 docx 复查）。适用于国防科技173计划、装备预研快速支持、军科委快速响应、国防科工局基础科研、国家重点研发计划、国自然等申报场景。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "chinese",
    "项目书",
    "申报书",
    "科研项目",
    "proposal"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.5"
    }
  },
  "files": [
    "cordis.patch.yml",
    "skills/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ccccty/proposal-generator-cn.git"
  },
  "homepage": "https://github.com/ccccty/proposal-generator-cn",
